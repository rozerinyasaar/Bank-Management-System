public class Product {

    private String productName;
    private String productColor;
    private String productCategory;
    private String productDescription;
    private int stock;
    private double productWeight;

    public Product(String productName, String productColor, String productCategory, String productDescription, int stock, double productWeight) {
        this.productName = productName;
        this.productColor = productColor;
        this.productCategory = productCategory;
        this.stock = stock;
        this.productWeight = productWeight;
        this.productDescription = productDescription;
    }

     public boolean reduceStock(int quantity) {
        if (checkStock(quantity)) {
            stock -= quantity;
            System.out.println(quantity + "units of" + productName + "removed from stock.Remaining stock:" + stock);
        return true;
        } else {
            System.out.println("Insufficient stock.");
        return false;
        }

    }
    
    public boolean checkStock(int quantity) {
        return stock >= quantity;
    }

   

    public String getProductName() {
        return productName;
    }

    public String getProductColor() {
        return productColor;
    }

    public String getProductCategory() {
        return productCategory;
    }

     public String getPoductDescription() {
        return productDescription;
    }

    public int getStock() {
        return stock;
    }

    public double getProductWeight() {
        return productWeight;
    }

   
    public void setProductName(String productName) {
        this.productName = productName;
    }

    public void setProductColor(String productColor) {
        this.productColor = productColor;
    }

    public void setProductCategory(String productCategory) {
        this.productCategory = productCategory;
    }
    
     public void setProductDescription(String productDescription) {
        this.productDescription = productDescription;
    }

    public void setStock(int stock) {
        this.stock = stock;
    }

    public void setProductWeight(double productWeight) {
        this.productWeight = productWeight;
    }

   

}
