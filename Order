public class Order {

    private User user;
    private Product product;
    private CreditCard creditCard;
    private int quantity;

    public Order(User user, Product product, CreditCard creditCard, int quantity) {
        this.creditCard = creditCard;
        this.product = product;
        this.user = user;
        this.quantity = quantity;
    }

    public void processOrder() {

        if (product.checkStock(quantity)) {
            product.reduceStock(quantity);
            user.getOrders().add(this);
            System.out.println("Order processed:" + quantity + "x" + product.getProductName());

        } else {
            System.out.println("You cannot order this product,the stock is not enough:" + product.getProductName());
        }
    }

    public User getUser() {
        return user;
    }
    
    public Product getProduct(){
        return product;
    } 
    
    public CreditCard getCreditCard(){
        return creditCard;
    }
    
    public int getQuantity(){
        return quantity;
    }
    
    public void setUser(User user) {
      this.user = user;
    }
    
    public void setProduct(Product product){
        this.product = product;
    } 
    
    public void setCreditCard(CreditCard creditCard){
        this.creditCard = creditCard;
    }
    
    public void setQuantity(int quantity){
        this.quantity = quantity;
    }
}
