             System.out.println(order.getQuantity()+"x"+order.getProduct().getProductName());
         }
         System.out.println("------------------");
         
         System.out.println("Favorite Products");
         for(Product favorite:user.getFavoriteProduct()){
             System.out.println(favorite.getProductName());
         }
         
         System.out.println("------------------");
         
         System.out.println("Stock:"+product.getStock());
